{
  "name": "@jup-ag/i18n-sandbox-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run i18n:compile && vite build",
    "dev": "vite dev",
    "i18n:compile": "lingui compile --strict --typescript --workers 1 --output-prefix \"/*oxlint-disable*/\"",
    "i18n:extract": "lingui extract --clean --overwrite --workers 1",
    "i18n:sync": "pnpm run i18n:extract && pnpm run i18n:compile",
    "lint:check": "oxlint ./src --quiet",
    "lint:fix": "oxlint ./src --fix",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@jup-ag/ui": "workspace:*",
    "@lingui/core": "6.6.0",
    "@lingui/react": "6.6.0",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/react-start": "1.168.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jup-ag/tailwind-config": "workspace:*",
    "@jup-ag/tsconfig": "workspace:*",
    "@lingui/cli": "6.6.0",
    "@lingui/format-po": "6.6.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "20.19.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "8.0.16",
    "vitest": "catalog:"
  }
}
