{
  "name": "jupiter-i18n-translation-pilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run i18n:compile && vite build && oxfmt src/routeTree.gen.ts",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vite dev",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "i18n:compile": "lingui compile --strict --typescript --workers 1 --output-prefix \"/*oxlint-disable*/\" && oxfmt src/i18n/locales/*/messages.ts",
    "i18n:extract": "lingui extract --clean --overwrite --workers 1",
    "i18n:sync": "pnpm run i18n:extract && pnpm run i18n:compile",
    "lint:check": "oxlint ./src ./scripts --quiet",
    "lint:fix": "oxlint ./src ./scripts --fix",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsgo --noEmit",
    "verify:ssr": "pnpm run build && node scripts/verify-ssr.mjs && oxfmt src/routeTree.gen.ts"
  },
  "dependencies": {
    "@lingui/core": "6.6.0",
    "@lingui/react": "6.6.0",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/react-start": "1.168.25",
    "clsx": "2.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@iconify-json/ph": "1.2.2",
    "@iconify/tailwind4": "1.2.3",
    "@lingui/cli": "6.6.0",
    "@lingui/format-po": "6.6.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "20.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260113.1",
    "@vitejs/plugin-react": "6.0.2",
    "happy-dom": "14.12.3",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.8.3",
    "vite": "8.0.16",
    "vitest": "3.2.4",
    "wrangler": "4.126.0"
  },
  "packageManager": "pnpm@10.19.0"
}
