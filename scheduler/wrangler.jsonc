{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jupiter-i18n-translation-pilot-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CROWDIN_SCHEDULER",
        "class_name": "CrowdinExportScheduler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CrowdinExportScheduler"],
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
