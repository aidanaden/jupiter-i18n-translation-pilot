#. Onboard method description captured from the pinned Jupiter baseline. Protected placeholders render as SOL, USDC, Apple Pay, Google Pay, USD, and EUR.
#: src/i18n/messages.ts
msgid "baseline.onboard.buy-description"
msgstr "Purchase {SOL} or {USDC} via {applePay}, {googlePay}, credit cards with your local currencies like {USD}, {EUR}"

#. Onboard method title captured from the pinned Jupiter baseline.
#: src/i18n/messages.ts
msgid "baseline.onboard.buy-title"
msgstr "Buy crypto with local currencies"

#. Onboard method description captured from the pinned Jupiter baseline. Protected placeholders render as Coinbase, Binance, and Solana.
#: src/i18n/messages.ts
msgid "baseline.onboard.cex-description"
msgstr "Transfer your crypto funds from exchanges like {coinbase} or {binance} to your {solana} wallet directly"

#. Onboard method title captured from the pinned Jupiter baseline.
#: src/i18n/messages.ts
msgid "baseline.onboard.cex-title"
msgstr "Transfer funds from Exchanges"

#. Onboard section heading captured from the pinned Jupiter baseline.
#: src/i18n/messages.ts
msgid "baseline.onboard.more-ways"
msgstr "More ways to deposit"

#. Onboard page subtitle captured from the pinned Jupiter baseline. The protected placeholder renders as Solana.
#: src/i18n/messages.ts
msgid "baseline.onboard.subtitle"
msgstr "The easiest way to get started on {solana}"

#. Onboard page title captured from the pinned Jupiter baseline. The protected placeholder renders as Jupiter.
#: src/i18n/messages.ts
msgid "baseline.onboard.title"
msgstr "Deposit via {jupiter}"

#. Primary action that opens the fixed swap review in the translation sandbox.
#: src/i18n/messages.ts
msgid "baseline.swap.review"
msgstr "Review swap"

#. Synthetic proof message used only by the autonomous end-to-end translation rehearsal.
#: src/i18n/messages.ts
msgid "pilot.recording.proof"
msgstr "Review the quoted amount before you confirm this swap."

#. Sandbox-only empty state shown without a network request.
#: src/i18n/messages.ts
msgid "sandbox.onboard.unavailable"
msgstr "No deposit methods are available in this preview."

#. Sandbox-only ICU select. Preserve the walletState variable.
#: src/i18n/messages.ts
msgid "sandbox.onboard.wallet-state"
msgstr "{walletState, select, new {Set up your first wallet} funded {Add funds to your wallet} other {Review your wallet}}"

#. Number of synthetic markets used by the fixed route. Preserve the routeCount variable.
#: src/i18n/messages.ts
msgid "sandbox.swap.market-count"
msgstr "{routeCount, plural, one {This route uses # market} other {This route uses # markets}}."

#. Sandbox-only guidance. Preserve the link rich-text placeholder.
#: src/components/SwapExample.tsx
msgid "sandbox.translation.guide"
msgstr "Read the <link>translation guide</link> before editing placeholders."

#. Available token balance beside a swap input. Preserve the {balance} placeholder exactly; it is a preformatted amount, not text to translate.
#: src/i18n/messages.ts
msgid "swap.form.balance"
msgstr "Balance {balance}"

#. Swap order-type tab for an order with a specified execution price. Limit means a limit order, not a spending cap.
#: src/i18n/messages.ts
msgid "swap.form.limit"
msgstr "Limit"

#. Swap order-type tab for an immediate swap at the current market quote. Market means an order type, not a marketplace.
#: src/i18n/messages.ts
msgid "swap.form.market"
msgstr "Market"

#. Swap form label above the token amount the user will spend. Token symbols and amounts are rendered separately and must not be translated.
#: src/i18n/messages.ts
msgid "swap.form.pay"
msgstr "You pay"

#. Swap form label above the quoted token amount the user will receive. This is a quote, not a guaranteed amount.
#: src/i18n/messages.ts
msgid "swap.form.receive"
msgstr "You receive"

#. Swap order-type tab for repeated scheduled orders. Use the team's preferred term for recurring investment orders.
#: src/i18n/messages.ts
msgid "swap.form.recurring"
msgstr "Recurring"
